    {
      "mode": "managed",
      "type": "google_bigquery_routine",
      "name": "is_valid_cusip",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arguments": [
              {
                "argument_kind": "FIXED_TYPE",
                "data_type": "{\"typeKind\":\"STRING\"}",
                "mode": "",
                "name": "cusip",
                "table_type": []
              }
            ],
            "creation_time": 1790907475355,
            "data_governance_type": "",
            "dataset_id": "dev_vishnu",
            "definition_body": "(\r\n  WITH input_data AS (\r\n    SELECT UPPER(TRIM(cusip)) AS c\r\n  )\r\n  SELECT\r\n    CASE\r\n      WHEN c IS NULL OR NOT REGEXP_CONTAINS(c, r'^[0-9A-Z*@#]{8}[0-9]$') THEN FALSE\r\n      ELSE (\r\n        SELECT\r\n          MOD(10 - MOD(SUM(DIV(prod, 10) + MOD(prod, 10)), 10), 10) = CAST(SUBSTR(c, 9, 1) AS INT64)\r\n        FROM\r\n          UNNEST(GENERATE_ARRAY(1, 8)) AS pos,\r\n          UNNEST([SUBSTR(c, pos, 1)]) AS ch,\r\n          UNNEST([\r\n            CASE\r\n              WHEN ch BETWEEN '0' AND '9' THEN CAST(ch AS INT64)\r\n              WHEN ch BETWEEN 'A' AND 'Z' THEN ASCII(ch) - 55\r\n              WHEN ch = '*' THEN 36\r\n              WHEN ch = '@' THEN 37\r\n              WHEN ch = '#' THEN 38\r\n            END * IF(MOD(pos, 2) = 0, 2, 1)\r\n          ]) AS prod\r\n      )\r\n    END\r\n  FROM input_data\r\n)\r\n",
            "deletion_policy": "DELETE",
            "description": "Validates whether a given string is a valid CUSIP number using the Modulus 10 check-digit algorithm.",
            "determinism_level": "",
            "id": "projects/project-fd305953-166e-42aa-8d5/datasets/dev_vishnu/routines/is_valid_cusip",
            "imported_libraries": [],
            "language": "SQL",
            "last_modified_time": 1790907475355,
            "project": "project-fd305953-166e-42aa-8d5",
            "remote_function_options": [],
            "return_table_type": "",
            "return_type": "{\"typeKind\":\"BOOL\"}",
            "routine_id": "is_valid_cusip",
            "routine_type": "SCALAR_FUNCTION",
            "security_mode": "",
            "spark_options": [],
            "timeouts": null
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjoxMjAwMDAwMDAwMDAwLCJkZWxldGUiOjEyMDAwMDAwMDAwMDAsInVwZGF0ZSI6MTIwMDAwMDAwMDAwMH19"
        }
      ]
    },
